# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Secrets & local config ----
# NEVER commit these. This project handles sensitive data by design;
# a leaked .env in a DLP project is an embarrassing story to tell.
.env
.env.local
*.pem
*.key

# ---- Database ----
# The decision store. It holds no prompt text — the schema has no
# column that can — but it IS a record of when each user was warned or
# blocked, which is local user data and not ours to commit.
#
# The -wal and -shm files matter as much as the .db: SQLite buffers
# recent writes in the write-ahead log, so committing only the .db
# while ignoring the WAL would be the same mistake in a subtler form.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- Node / dashboard ----
node_modules/
dist/
build/
.vite/

# ---- Evaluation artefacts ----
# Keep the labelled corpus (it is source data), ignore generated results.
evaluation/results/*
!evaluation/results/.gitkeep

# ---- Captured images ----
# Screenshots pulled from the browser during OCR testing may contain
# real secrets. Never version them.
evaluation/data/images/
*.uploaded.png

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# Tool-permission approvals are per-machine, not project source.
