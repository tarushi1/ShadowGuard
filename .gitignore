# ---- Python ----
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ---- Secrets & local config ----
# NEVER commit these. This project handles sensitive data by design;
# a leaked .env in a DLP project is an embarrassing story to tell.
.env
.env.local
*.pem
*.key

# ---- Database ----
# The decision store. It holds no prompt text — the schema has no
# column that can — but it IS a record of when each user was warned or
# blocked, which is local user data and not ours to commit.
#
# The -wal and -shm files matter as much as the .db: SQLite buffers
# recent writes in the write-ahead log, so committing only the .db
# while ignoring the WAL would be the same mistake in a subtler form.
data/
*.db
*.db-wal
*.db-shm
*.sqlite
*.sqlite3

# ---- Node / dashboard ----
node_modules/
dist/
build/
.vite/

# ---- Evaluation artefacts ----
# Keep the labelled corpus (it is source data), ignore generated results.
evaluation/results/*
!evaluation/results/.gitkeep

# ---- Captured images ----
# Screenshots pulled from the browser during OCR testing may contain
# real secrets. Never version them.
evaluation/data/images/
*.uploaded.png

# ---- OS / editor ----
.DS_Store
.idea/
.vscode/*
!.vscode/settings.json

# ---- Local editor and tool state ----
# Tool-permission approvals are per-machine, not project source.

# ---- Patent drafts ----
# NOT versioned, and deliberately so. This repository is intended to be
# pushed to a PUBLIC GitHub remote. In India a public disclosure before
# filing destroys novelty (Patents Act 1970, ss. 29-34; the s.31 grace
# period covers only narrow cases such as display at a government
# exhibition or a paper read before a learned society). Committing a
# draft specification here and pushing it would be exactly such a
# disclosure, made by accident, and it cannot be undone by deleting the
# file afterwards -- git history and any fork or mirror retain it.
patent/

# Generated report artefact — rebuilt from docs/project-1-report.md by tools/build-report.js
ShadowGuard AI - Project-1 Report.docx
