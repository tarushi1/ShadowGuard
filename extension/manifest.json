{
  "manifest_version": 3,
  "name": "ShadowGuard AI",
  "version": "0.14.0",
  "description": "Context-aware multimodal data loss prevention for enterprise interactions with generative AI platforms.",
  "action": {
    "default_title": "ShadowGuard AI"
  },
  "permissions": [
    "storage"
  ],
  "host_permissions": [
    "http://127.0.0.1:8000/*",
    "http://localhost:8000/*"
  ],
  "background": {
    "service_worker": "src/background/service_worker.js"
  },
  "content_scripts": [
    {
      "matches": [
        "https://chatgpt.com/*",
        "https://chat.openai.com/*",
        "https://gemini.google.com/*"
      ],
      "js": [
        "src/shared/messages.js",
        "src/shared/config.js",
        "src/adapters/registry.js",
        "src/adapters/chatgpt.js",
        "src/adapters/gemini.js",
        "src/content/composer_watcher.js",
        "src/content/interceptor.js",
        "src/content/attachment_interceptor.js",
        "src/ui/modal.js",
        "src/content/content.js"
      ],
      "run_at": "document_idle",
      "all_frames": false
    }
  ]
}
